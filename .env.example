# Copiá este archivo como .env.local y completá con los datos de tu proyecto de Supabase
# (Project Settings → API). Usá la "publishable key" (o "anon key"), NUNCA la "secret key".
EXPO_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
EXPO_PUBLIC_SUPABASE_KEY=tu-publishable-key

# Dirección pública de la web, para los links de invitación a grupos (por ejemplo https://brote.expo.app).
# Si no está, en la web se usa la dirección actual y en la app un link brote://...
EXPO_PUBLIC_URL_WEB=
